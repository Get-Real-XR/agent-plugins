{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v jj >/dev/null 2>&1 || { echo 'jj-tools: jj (Jujutsu) is required but not found. Install: https://jj-vcs.github.io/jj/latest/install-and-setup/' >&2; exit 1; }",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jj-worktree-create.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jj-worktree-remove.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
